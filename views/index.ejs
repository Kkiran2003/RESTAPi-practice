<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Quora Posts</h1>
    <% for(post of posts){ %>
        <div class="post">
            <h2 class="user">@<%= post.username %></h2>
            <h3 class="content"><%= post.content %></h3>
            <br>
            <a href="http://localhost:8080/posts/<%=post.id%>" class="detail">see in detail</a>&nbsp; 
            <a href="http://localhost:8080/posts/<%=post.id%>/edit" class="detail">edit</a>
        </div>
        
    <%}%>
    <a href="http:\\localhost:8080/posts/new" class="new">New post</a>
</body>
</html>